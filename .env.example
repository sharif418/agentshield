# ─── AgentShield Dashboard ────────────────────────────────────────────────────
# Copy this file to .env and fill in the values before running the application.
#
#   cp .env.example .env
#

# ─── Database ─────────────────────────────────────────────────────────────────
# Option 1: SQLite (DEFAULT — zero configuration, great for development & demos)
DATABASE_URL=file:./../db/agentshield.db

# Option 2: PostgreSQL (RECOMMENDED for production deployments)
# Uncomment the line below and comment out the SQLite line above.
# Also change prisma/schema.prisma → provider = "postgresql"
# DATABASE_URL=postgresql://user:password@localhost:5432/agentshield

# ─── API Authentication ──────────────────────────────────────────────────────
# Required in production mode. In development, API key auth is skipped.
# Generate a secure key: openssl rand -hex 32
AGENTSHIELD_API_KEY=your-secret-api-key-here

# ─── WebSocket Service ───────────────────────────────────────────────────────
# Port for the approval WebSocket service (mini-services/approval-ws)
WS_PORT=3003
# Client-facing port (must match WS_PORT; exposed to browser via NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_WS_PORT=3003

# ─── Application ──────────────────────────────────────────────────────────────
# Node environment: development | production | test
NODE_ENV=development
