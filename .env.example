# ─── AgentShield Dashboard ────────────────────────────────────────────────────
# Copy this file to .env and fill in the values before running the application.

# ─── Database ─────────────────────────────────────────────────────────────────
# SQLite relative path from the prisma/ directory
DATABASE_URL=file:./../db/custom.db

# ─── API Authentication ──────────────────────────────────────────────────────
# Required in production mode. In development, API key auth is skipped.
AGENTSHEILD_API_KEY=your-secret-api-key-here

# ─── WebSocket Service ───────────────────────────────────────────────────────
# Port for the approval WebSocket service (mini-services/approval-ws)
WS_PORT=3003
# Client-facing port (must match WS_PORT; exposed to browser via NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_WS_PORT=3003

# ─── Application ──────────────────────────────────────────────────────────────
# Node environment: development | production | test
NODE_ENV=development
