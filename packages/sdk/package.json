{
  "name": "agentshield",
  "version": "1.0.0",
  "description": "AgentShield — Deterministic Runtime Policy Engine for AI Agents. Intercept, evaluate, and govern every tool call.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "license": "MIT",
  "keywords": [
    "ai",
    "agent",
    "policy",
    "governance",
    "shield",
    "runtime",
    "safety",
    "agentshield",
    "zero-trust",
    "guardrails",
    "tool-call",
    "evaluation",
    "langchain",
    "openai",
    "llm"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/agentshield/agentshield",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/agentshield/agentshield#readme",
  "sideEffects": false,
  "dependencies": {
    "@agentshield/core": "workspace:*"
  },
  "peerDependencies": {},
  "devDependencies": {
    "typescript": "^5",
    "vitest": "^4.1.4"
  }
}
