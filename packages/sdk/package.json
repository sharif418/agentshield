    "tool-call",
    "evaluation",
    "langchain",
    "openai",
    "llm"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sharif418/agentshield.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/sharif418/agentshield#readme",
  "sideEffects": false,
  "dependencies": {
    "@agentshieldhq/core": "^1.0.0"
  },
  "peerDependencies": {},
