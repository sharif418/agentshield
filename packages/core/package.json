    "governance",
    "zero-trust",
    "guardrails",
    "deterministic",
    "runtime"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/agentshield/agentshield",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/agentshield/agentshield#readme",
  "sideEffects": false,
  "devDependencies": {
    "typescript": "^5",
    "vitest": "^4.1.4"
  }
}
