    "langchain": ">=0.1.0"
  },
  "peerDependenciesMeta": {
    "langchain": {
      "optional": true
    }
  },
  "dependencies": {
    "@agentshieldhq/sdk": "^1.0.0",
    "@agentshieldhq/core": "^1.0.0"
